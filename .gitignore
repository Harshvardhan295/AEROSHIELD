# ==============================================================================
# AeroShield - .gitignore
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Local test & sample binaries (prevent accidental upload of malware/test binaries)
*.exe
*.dll
*.bin
*.sys

# Datasets (large raw CSV training data)
dataset_malwares.csv
dataset_test.csv

# Environment variables & secrets
.env
.env.local
.env.*.local

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*.swo

# IDE & OS-specific files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
